{
  "name": "electron-react-app",
  "version": "1.0.0",
  "description": "An Electron, Node.js, and React desktop application.",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && cross-env NODE_ENV=development node start-electron.js\"",
    "prebuild": "node scripts/prebuild-setup.js",
    "build": "npm run prebuild && vite build && electron-builder",
    "clean": "rimraf dist out",
    "rebuild": "npm run clean && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:verify": "node scripts/verify-database.js",
    "test:db": "NODE_ENV=development node scripts/verify-database.js",
    "test": "jest --passWithNoTests",
    "test:run": "jest --passWithNoTests --forceExit"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "modbus-serial": "^8.0.25",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^30.4.1",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.8",
    "prisma": "^5.21.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.3.1",
    "wait-on": "^7.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.electronreact.app",
    "productName": "WarehouseApp",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@prisma/engines/**/*",
      "node_modules/.prisma/**/*",
      "desktop/prisma/*.node"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/wareHouse.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "jest": {
    "projects": [
      {
        "displayName": "backend",
        "testEnvironment": "node",
        "testMatch": [
          "**/desktop/**/__tests__/**/*.test.js"
        ]
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jsdom",
        "testMatch": [
          "**/src/**/__tests__/**/*.test.js"
        ],
        "transform": {
          "^.+\\.(js|jsx)$": "babel-jest"
        },
        "moduleNameMapper": {
          "\\.(css|less|scss)$": "<rootDir>/__mocks__/styleMock.js"
        }
      }
    ]
  }
}
